# TrustKey CRM — server configuration.
# Copy to .env.local for local development; set the same names in the Railway
# service for production. Values here are placeholders, never real secrets.
#
# Anything marked REQUIRED is a hard boot gate in production: the server refuses
# to start without it rather than run in a silently degraded state.

# ─── Core (REQUIRED in production) ───────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/trustkey
# Signs login tokens. Without it the server falls back to a public literal, i.e.
# anyone could forge an owner session.
JWT_SECRET=
# Shared secret on the OpenPhone webhook URL (?key=...). Without it, anyone can
# inject fake calls and SMS.
OPENPHONE_WEBHOOK_SECRET=
# Shared secret for the website lead endpoint (POST /api/jobs/inbound).
WEBSITE_WEBHOOK_SECRET=

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
# sk_live_... in production. A forgotten sk_test_ key takes payments that never
# move real money and looks identical in the UI — the readiness screen flags it.
STRIPE_SECRET_KEY=
# REQUIRED whenever STRIPE_SECRET_KEY is set. Without it the webhook is refused,
# so clients could pay and the CRM would never record it.
STRIPE_WEBHOOK_SECRET=
# Base URL for the payment, receipt and success pages. Falls back to
# RAILWAY_PUBLIC_DOMAIN, then the request host.
PUBLIC_BASE_URL=

# ─── SMS / calls (OpenPhone) ─────────────────────────────────────────────────
# Missing values disable SMS SILENTLY — no arrival texts, reminders or receipts.
OPENPHONE_API_KEY=
OPENPHONE_PHONE_NUMBER=+16025550199
OPENPHONE_PHONE_NUMBER_ID=

# ─── AI (Gemini) ─────────────────────────────────────────────────────────────
# Server-side ONLY. Never expose this as a VITE_* variable: those are compiled
# into the public browser bundle.
GEMINI_API_KEY=
# Optional: override the realtime voice model when Google retires a snapshot.
VOICE_MODEL=

# ─── Maps (optional; falls back to free OSM/OSRM) ────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Web push (optional) ─────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# ─── Email receipts (optional) ───────────────────────────────────────────────
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_FROM=

# ─── Scheduler ───────────────────────────────────────────────────────────────
BUSINESS_TZ=America/Phoenix
DIGEST_HOUR=20
# Set to 'true' to stop payment reminders and the evening digest.
SCHEDULER_DISABLED=
# Where new website leads are announced if no owner/manager phone is on file.
LEAD_NOTIFY_PHONE=

# ─── Hardening ───────────────────────────────────────────────────────────────
# Comma-separated. Unset means CORS reflects every origin.
ALLOWED_ORIGINS=https://your-app.vercel.app
# Password for the seeded owner account on a brand-new database. Set it, or the
# server generates one and prints it to the boot log, where it persists.
OWNER_INITIAL_PASSWORD=
# Postgres TLS is auto-negotiated. Override only if you must: 'require' or 'disable'.
PGSSLMODE=
# Signs the public receipt/pay links. Falls back to JWT_SECRET when unset — set it so
# rotating JWT_SECRET doesn't dead-link every receipt already texted to a customer.
RECEIPT_SECRET=

# ─── AI cost ceilings (optional; defaults shown) ─────────────────────────────
# Per-request output cap, per-request body cap, and a per-user daily token budget.
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_REQUEST_BYTES=262144
AI_DAILY_TOKEN_BUDGET=400000

# ─── Frontend (Vercel build env) ─────────────────────────────────────────────
# PUBLIC — compiled into the browser bundle. Never put a secret in a VITE_ var.
VITE_API_BASE=https://your-backend.up.railway.app
